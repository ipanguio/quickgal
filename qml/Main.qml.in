import QtQuick 2.7
import QtQuick.Window 2.2
import QtSystemInfo 5.5

@QML_THUMBNAILER_IMPORT@
@QML_COMPONENTS_IMPORT@
@QML_POPUPS_IMPORT@
@QML_CONTENT_IMPORT@

Window {
    id: window

    visible: true

    width: units.gu(45)
    height: units.gu(75)

    title: "QuickGal"

    MainView {
        id: mainView

        anchors.fill: parent
        applicationName: "quickgal.nacho"

        function openVideo(videoPath) {
            var videoUrl = "video://" + videoPath
            var ok = Qt.openUrlExternally(videoUrl)
        }

        function isVideoPath(filePath){
            var lower = filePath.toLowerCase()

            return lower.endsWith(".mp4") || 
                   lower.endsWith(".mkv") || 
                   lower.endsWith(".avi") || 
                   lower.endsWith(".mov") || 
                   lower.endsWith(".webm") || 
                   lower.endsWith(".3gp")
        }

        PageStack {
            id: pageStack

            anchors.fill: parent

            Component.onCompleted: {
                push(albumsPage)
            }
        }

        Component {
            id: albumsPage

            Page {
                id: page

                header: PageHeader {
                    id: pageHeader
                    title: "QuickGal"

                    trailingActionBar.actions: [
                        Action {
                            text: i18n.tr("Opciones")
                            iconName: "navigation-menu"

                            onTriggered: {
                                PopupUtils.open(
                                    albumsMenuComponent,
                                    pageHeader.trailingActionBar
                                )
                            }
                        }
                    ]
                }

                GridView {
                    id: albumGrid

                    property real targetCelWidth: units.gu(18)
                    property int columns: Math.max(2, Math.floor(width / targetCelWidth))

                    anchors {
                        top: pageHeader.bottom
                        left: parent.left
                        right: parent.right
                        bottom: parent.bottom
                    }

                    clip: true

                    cellWidth: width / columns
                    cellHeight: cellWidth + units.gu(6)

                    model: albumModel

                    delegate: Item {
                        id: albumDelegate

                        property string albumCoverPath: coverPath
                        property string albumThumbnailSource: ""

                        width: albumGrid.cellWidth
                        height: albumGrid.cellHeight

                        Component.onCompleted: {
                            if (!mainView.isVideoPath(albumCoverPath)) {
                                albumThumbnailSource = thumbnailProvider.requestThumbnail(albumCoverPath)
                            }
                        }

                        Connections {
                            target: thumbnailProvider

                            onThumbnailReady: {
                                if (imagePath === albumDelegate.albumCoverPath) {
                                    albumDelegate.albumThumbnailSource = thumbnailUrl
                                }
                            }
                        }

                        Rectangle {
                            anchors {
                                fill: parent
                                margins: units.gu(1)
                            }

                            color: theme.palette.normal.background

                            Column {
                                anchors {
                                    fill: parent
                                    margins: units.gu(1)
                                }

                                spacing: units.gu(0.5)

                                Rectangle {
                                    width: parent.width
                                    height: width

                                    color: "#cccccc"

                                    Image {
                                        anchors.fill: parent
                                        
                                        source: mainView.isVideoPath(albumDelegate.albumCoverPath)
                                            ? "image://thumbnailer/" +
                                              Qt.resolvedUrl(albumDelegate.albumCoverPath)
                                            : albumDelegate.albumThumbnailSource

                                        fillMode: Image.PreserveAspectCrop

                                        sourceSize: Qt.size(
                                            Math.max(1, Math.round(width)),
                                            Math.max(1, Math.round(height))
                                        )

                                        onStatusChanged: {
                                            if (status === Image.Error) {
                                                console.log("No se pudo generar miniatura: ", path)
                                            }
                                        }

                                        asynchronous: true
                                        cache: true
                                    }
                                }

                                Label {
                                    width: parent.width

                                    text: name

                                    font.bold: true
                                    elide: Text.ElideRight
                                }

                                Label {
                                    text: i18n.tr(
                                        "%1 elemento",
                                        "%1 elementos",
                                        count
                                        ).arg(count)
                                }
                            }

                            MouseArea {
                                anchors.fill: parent

                                onClicked: {
                                    appController.openAlbum(path)

                                    pageStack.push(
                                        albumPageComponent,
                                        {
                                            albumName: name,
                                            albumName: path
                                        }
                                    )
                                }
                            }
                        }
                    }
                }

                PullToRefresh {
                    target: albumGrid

                    onRefresh: {
                        console.log("Recargando álbumes: ")

                        appController.refreshAlbums()

                        albumGrid.positionViewAtBeginning()
                    }
                }

                Component {
                    id: albumsMenuComponent

                    Popover {
                        id: albumsMenu

                        Column {
                            width: units.gu(25)

                            ListItem {
                                height: units.gu(6)

                                ListItemLayout {
                                    title.text: i18n.tr("Ordenar por")
                                }

                                onClicked: {
                                    PopupUtils.close(albumsMenu)

                                    PopupUtils.open(
                                        sortPopoverComponent,
                                        pageHeader.trailingActionBar,
                                        {
                                            target: "albums"
                                        }
                                    )
                                }
                            }

                            ListItem {
                                height: units.gu(6)

                                ListItemLayout {
                                    title.text: i18n.tr("Mostrar ocultos")

                                    CheckBox {
                                        id: hiddenAlbumsCheckBox

                                        SlotsLayout.position: SlotsLayout.Trailing
                                        checked: appController.showHiddenAlbums

                                        onClicked: {
                                            appController.showHiddenAlbums = checked
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        Component {
            id: albumPageComponent

            Page {
                id: albumPage

                property string albumName: ""
                property string albumPath: ""

                Connections {
                    target: mediaModel

                    onVideoOnlyChanged: {
                        console.log("mediaModel.videoOnly cambiado:", mediaModel.videoOnly)
                        }
                }

                header: PageHeader {
                    id: albumHeader
                    title: albumPage.albumName

                    trailingActionBar.actions: [
                        Action {
                            text: i18n.tr("Opciones")
                            iconName: "navigation-menu" 

                            onTriggered: {
                                PopupUtils.open(
                                    albumMenuComponent,
                                    albumHeader.trailingActionBar
                                )
                            }
                        }
                    ]
                }

                GridView {
                    id: mediaGrid

                    property real targetCellWidth: units.gu(14)
                    property int columns: 
                        Math.max(3, Math.floor(width / targetCellWidth))

                    cellWidth: width / columns
                    cellHeight: cellWidth

                    anchors {
                        top: albumHeader.bottom
                        left: parent.left
                        right: parent.right
                        bottom: parent.bottom
                    }

                    model: mediaModel

                    delegate: Item {
                        id: mediaDelegate

                        width: mediaGrid.cellWidth
                        height: mediaGrid.cellHeight

                        property string mediaPath: path
                        property string thumbnailSource: ""

                        Component.onCompleted: {
                            if (!isVideo) {
                                thumbnailSource = thumbnailProvider.requestThumbnail(mediaPath)
                            }
                        }

                        Connections {
                            target: thumbnailProvider

                            onThumbnailReady: {
                                if (!isVideo && imagePath === mediaDelegate.mediaPath) {
                                    mediaDelegate.thumbnailSource = thumbnailUrl
                                }
                            }
                        }

                        Rectangle {
                            /* 
                             * Pictures
                             */
                            anchors {
                                fill : parent
                                margins: units.gu(0.25)                                
                            }

                            color: "#cccccc"

                            Image {
                                anchors.fill: parent
                                source: isVideo
                                    ? "image://thumbnailer/" + Qt.resolvedUrl(path)
                                    : mediaDelegate.thumbnailSource

                                sourceSize: Qt.size(
                                    Math.max(1, Math.round(width)),
                                    Math.max(1, Math.round(height))
                                )
                                
                                fillMode: Image.PreserveAspectCrop
                                asynchronous : true
                                cache: true
                            }
                        }

                        Rectangle {
                            /*
                             * Videos, added and icon to differentiate from pictures
                             */
                            visible: isVideo

                            anchors {
                                right: parent.right
                                bottom: parent.bottom
                                margins: units.gu(0.5)
                            }

                            width: units.gu(3)
                            height: units.gu(3)
                            radius: width / 2

                            color: "#80000000"

                            Label {
                                anchors.centerIn: parent
                                text: "▶"
                                color: "white"
                            }
                        }

                        MouseArea {
                            anchors.fill: parent

                            onClicked: {
                                if (isVideo) {
                                    mainView.openVideo(path)
                                } else {
                                    pageStack.push(
                                        imagePageComponent,
                                        {
                                            initialIndex: index
                                        }
                                    )
                                }
                            }
                        }
                    }
                }

                PullToRefresh {
                    target: mediaGrid

                    onRefresh: {
                        console.log("Recargando album: ", albumPage.albumPath)

                        appController.openAlbum(albumPage.albumPath)


                        mediaGrid.positionViewAtBeginning()

                    }
                }

                Rectangle {
                    id: thumbnailBusyMessage

                    anchors {
                        horizontalCenter: parent.horizontalCenter
                        bottom: parent.bottom
                        bottomMargin: units.gu(3)
                    }

                    width: busyRow.width + units.gu(4)
                    height: units.gu(6)
                    radius: units.gu(1)
                    color: theme.palette.normal.background
                    visible: thumbnailProvider.busy
                    z: 100

                    Row {
                        id: busyRow

                        anchors.centerIn: parent
                        spacing: units.gu(1)

                        ActivityIndicator {
                            running: thumbnailProvider.busy
                        }

                        Label {
                            anchors.verticalCenter: parent.verticalCenter
                            text: i18n.tr("Generando miniaturas…")
                        }
                    }
                }

                Component {
                    id: albumMenuComponent

                    Popover {
                        id: albumMenu

                        Column {
                            width: units.gu(25)

                            ListItem {
                                height: units.gu(6)

                                ListItemLayout {
                                    title.text:i18n.tr("Ordenar por")
                                }

                                onClicked: {
                                    PopupUtils.close(albumMenu)

                                    PopupUtils.open(
                                        sortPopoverComponent,
                                        albumHeader.trailingActionBar,
                                        {
                                            target: "media"
                                        }
                                    )
                                }
                            }

                            ListItem {
                                visible: !mediaModel.videoOnly
                                height: visible ? units.gu(6) : 0

                                ListItemLayout{
                                    title.text : i18n.tr("Presentación de diapositivas")
                                }

                                onClicked: {
                                    PopupUtils.close(albumMenu)
                                    pageStack.push(slideshowPageComponent)
                                }
                            }
                        }
                    }
                }
            }
        }

        Component {
            id: sortPopoverComponent

            Popover {
                id: sortPopover

                property string target: "media"
                property string sortField: "name"
                property bool ascending: true

                contentWidth: Math.min(
                    window.width / 2,
                    units.gu(50)
                )

                Rectangle {
                    id: sortBackground

                    width: sortPopover.contentWidth
                    height: sortContent.height + units.gu(4)

                    color: "#e0e0e0"
                    radius: units.gu(1)

                    border.width: units.dp(1)
                    border.color: "#808080"

                    Column {
                        id: sortContent

                        width: parent.width - units.gu(4)

                        anchors {
                            top: parent.top
                            horizontalCenter: parent.horizontalCenter
                            topMargin: units.gu(2)
                        }

                        spacing: units.gu(1)

                        Label {
                            text: i18n.tr("Ordenar por:")
                            font.bold: true
                        }

                        Label {
                            width: parent.width
                            text: i18n.tr("Criterio")
                        }

                        OptionSelector {
                            id: sortFieldSelector

                            width: parent.width

                            model: [
                                i18n.tr("Nombre"),
                                i18n.tr("Ruta"),
                                i18n.tr("Tamaño"),
                                i18n.tr("Fecha de modificación"),
                                i18n.tr("Fecha de creación")
                            ]

                            selectedIndex: 0

                            onSelectedIndexChanged: {
                                switch (selectedIndex) {
                                case 0:
                                    sortPopover.sortField = "name"
                                    break
                                case 1:
                                    sortPopover.sortField = "path"
                                    break
                                case 2:
                                    sortPopover.sortField = "size"
                                    break
                                case 3:
                                    sortPopover.sortField = "modified"
                                    break
                                case 4:
                                    sortPopover.sortField = "created"
                                    break
                                }

                                if (sortPopover.target === "albums") {
                                    appController.sortAlbums(
                                        sortPopover.sortField,
                                        sortPopover.ascending
                                    )
                                } else {
                                    appController.sortMedia(
                                        sortPopover.sortField,
                                        sortPopover.ascending
                                    )
                                }
                            }
                        }

                        Label {
                            width: parent.width
                            text: i18n.tr("Dirección")
                        }

                        OptionSelector {
                            id: sortDirectionSelector
        
                            width: parent.width

                            model: [
                                i18n.tr("Ascendente"),
                                i18n.tr("Descendente")
                            ]

                            selectedIndex: 0

                            onSelectedIndexChanged: {
                                sortPopover.ascending =
                                selectedIndex === 0

                                if (sortPopover.target === "albums") {
                                    appController.sortAlbums(
                                        sortPopover.sortField,
                                        sortPopover.ascending
                                    )
                                } else {
                                    appController.sortMedia(
                                        sortPopover.sortField,
                                        sortPopover.ascending
                                    )
                                }
                            }
                        }

                        Button {
                            width: parent.width
                            text: i18n.tr("Cerrar")

                            onClicked: {
                                PopupUtils.close(sortPopover)
                            }
                        }
                    }
                }
            }
        }

        Component {
            id: imagePageComponent

            Page {
                id: imagePage

                property int initialIndex: 0
                property bool fullScreen: false
                property var activeTransfer: null

                Component {
                    id: contentItemComponent

                    ContentItem {
                    }
                }

                Component {
                    id: imageMenuComponent

                    Popover {
                        id: imageMenu

                        Column {
                            width: units.gu(25)

                            ListItem {
                                height: units.gu(5)

                                ListItemLayout {
                                    title.text: i18n.tr("Borrar imagen")
                                }

                                onClicked: {
                                    PopupUtils.close(imageMenu)
                                    
                                    PopupUtils.open(deleteImageDialogComponent, imagePage)
                                    console.log("Borrar ", imageViewer.currentItem.mediaPath)
                                }
                            }

                            ListItem {
                                height: units.gu(5)

                                ListItemLayout {
                                    title.text: i18n.tr("Abrir con ...")
                                }

                                onClicked: {
                                    console.log("Abrir con ... lanzado para ", imageViewer.currentItem.mediaPath)
                                    PopupUtils.close(imageMenu)
                                    /*
                                     * Start content Peer
                                    */
                                    imagePeerPicker.visible = true
                                }
                            }
                        }
                    }
                }

                Component {
                    id: deleteImageDialogComponent

                    Dialog {
                        id: deleteImageDialog

                        title: i18n.tr("Atención")
                        text: i18n.tr("¿Estás seguro de querer borrar esta imágen?")

                        Button {
                            text: i18n.tr("Cancelar")

                            onClicked: {
                                PopupUtils.close(deleteImageDialog)
                            }
                        }

                        Button {
                            text: i18n.tr("Borrar")

                            onClicked: {
                                var pathToDelete = imageViewer.currentItem.mediaPath
                                
                                var deleted = appController.deleteFile(pathToDelete)

                                console.log("Resultado deleteFile: ", deleted, pathToDelete)
                                
                                PopupUtils.close(deleteImageDialog)
                            }
                        }
                    }
                }

                ContentPeerPicker {
                    id: imagePeerPicker

                    anchors.fill: parent
                    visible: false
                    z: 1000

                    showTitle: true
                    contentType: ContentType.Pictures
                    handler: ContentHandler.Destination

                    onPeerSelected: {
                        console.log("Opción 'Aplicación seleccionada' devuelve: ", peer.name)

                        imagePage.activeTransfer = peer.request()

                        var item =
                            contentItemComponent.createObject(
                                imagePage,
                                {
                                    "url":
                                        "file://" + 
                                        imageViewer.currentItem.mediaPath
                                }
                            )

                        imagePage.activeTransfer.items = [ item ]

                        console.log("Enviando: ", item.url)

                        imagePage.activeTransfer.state = ContentTransfer.Charged

                        imagePeerPicker.visible = false
                    }

                    onCancelPressed: {
                        visible: false
                    }

                    Connections {
                        target: imagePage.activeTransfer
                                ? imagePage.activeTransfer
                                : null

                        onStateChanged: {
                            console.log("ContentTransfer state: ", imagePage.activeTransfer.state)

                            if (imagePage.activeTransfer.state ===
                                ContentTransfer.Aborted) {
                                    console.log("Transferencia peer cancelada")
                            }

                            if (imagePage.activeTransfer.state ===
                                ContentTransfer.Collected) {
                                    console.log("Contenido recogido por el destino")
                            }
                        }
                    }
                }

                header: PageHeader {
                    id: imageHeader
                    
                    visible: !imagePage.fullScreen

                    title: imageViewer.count > 0 && imageViewer.currentItem
                        ? (imageViewer.currentIndex + 1)
                          + "/"
                          + imageViewer.count
                          + " - "
                          + imageViewer.currentItem.mediaFileName
                        :""
                    
                    trailingActionBar.actions: [
                        Action {
                            text: i18n.tr("Opciones:")
                            iconName: "navigation-menu"

                            onTriggered: {
                                PopupUtils.open(imageMenuComponent, imageHeader.trailingActionBar)
                            }
                        }
                    ]
                }

                ListView {
                    id: imageViewer

                    interactive : false

                    anchors {
                        top: parent.top
                        left: parent.left
                        right: parent.right
                        bottom: parent.bottom
                    }

                    anchors.topMargin:
                        imagePage.fullScreen
                            ? 0
                            : imageHeader.height

                    orientation: ListView.Horizontal

                    model: mediaModel

                    currentIndex: imagePage.initialIndex
                    snapMode: ListView.SnapOneItem
                    highlightRangeMode: ListView.StrictlyEnforceRange
                    preferredHighlightBegin: 0
                    preferredHighlightEnd: 0
                    boundsBehavior: Flickable.StopAtBounds

                    clip: true

                    delegate: Rectangle {

                        id: imageDelegate

                        width: imageViewer.width
                        height: imageViewer.height

                        property string mediaFileName: fileName
                        property string mediaPath: path

                        color: "black"

                        Flickable {
                            id: imageFlickable

                            anchors.fill: parent
                            clip: true

                            property real zoom: 1.0
                            property real minZoom: 1.0
                            property real maxZoom: 5.0
                            
                            contentWidth: width * zoom
                            contentHeight: height * zoom

                            // Gestures are defined by us
                            interactive: false

                            boundsBehavior: Flickable.StopAtBounds

                            Item {
                                id: imageContainer

                                width: imageFlickable.width
                                height: imageFlickable.height

                                scale: imageFlickable.zoom
                                transformOrigin: Item.TopLeft

                                Image {
                                    anchors.fill: parent

                                    source: "file://" + path
                                    fillMode: Image.PreserveAspectFit

                                    asynchronous: true
                                    cache: true
                                    smooth: true
                                }
                            }

                            MultiPointTouchArea {
                                id: imageTouchArea

                                anchors.fill: parent

                                minimumTouchPoints: 1
                                maximumTouchPoints: 2

                                property double lastTapTime: 0
                                property int doubleTapInterval: 400
                                property real pressX: 0
                                property real pressY: 0
                                property real lastX: 0
                                property real lastY: 0
                                property bool moved: false
                                property bool pinching: false
                                property real pinchStartDistance: 0
                                property real pinchStartZoom: 1.0
                                property real imagePointX: 0
                                property real imagePointY: 0

                                touchPoints: [
                                    TouchPoint {
                                        id: touch1
                                    },
                                    TouchPoint {
                                        id: touch2
                                    }
                                ]

                                /*
                                 * Distance between the two fingers.
                                 */
                                function fingerDistance()
                                 {
                                    var dx = touch2.x - touch1.x
                                    var dy = touch2.y - touch1.y

                                    return Math.sqrt(dx * dx + dy * dy)
                                 }

                                 /*
                                  * Centre point between both fingers.
                                  */
                                function centerX()
                                {
                                    return (touch1.x + touch2.x) / 2
                                }
                                function centerY()
                                {
                                    return (touch1.y + touch2.y) / 2
                                }

                                onPressed: {
                                    console.log("Pressed")
                                    /*
                                     *Two fingers -> start pinch
                                     */
                                    if (touch1.pressed && touch2.pressed) {
                                        pinching = true
                                        moved = true
                                        pinchStartZoom = imageFlickable.zoom
                                        pinchStartDistance = fingerDistance()

                                        var cx = centerX()
                                        var cy = centerY()

                                        /*
                                         * Image point below the centre
                                         * of the pinch gesture
                                         */
                                        imagePointX = (imageFlickable.contentX + cx) / pinchStartZoom
                                        imagePointY = (imageFlickable.contentY + cy) / pinchStartZoom

                                        return
                                    }

                                    /*
                                     * One finger-
                                     */
                                    pressX = touch1.x
                                    pressY = touch1.y
                                    lastX = touch1.x
                                    lastY = touch1.y
                                    moved = false
                                }

                                onUpdated: {
                                    console.log("Updated")
                                    /*
                                     * Pinch
                                     */
                                    if (touch1.pressed && touch2.pressed) {
                                        if (!pinching){
                                            pinching = true
                                            moved = true
                                            pinchStartZoom = imageFlickable.zoom
                                            pinchStartDistance = fingerDistance()
                                            var startCX = centerX()
                                            var startCY = centerY()

                                            imagePointX = (imageFlickable.contentX + startCX) / pinchStartZoom
                                            imagePointY = (imageFlickable.contentY + startCY) / pinchStartZoom
                                        }
                                        var distance = fingerDistance()
                                        if (pinchStartDistance <= 0) {
                                            return
                                        }
                                        var newZoom = pinchStartZoom * distance / pinchStartDistance
                                        if (newZoom < imageFlickable.minZoom) {
                                            newZoom = imageFlickable.minZoom
                                        }
                                        if (newZoom > imageFlickable.maxZoom) {
                                            newZoom = imageFlickable.maxZoom
                                        }
                                        var cx = centerX()
                                        var cy = centerY()
                                        imageFlickable.zoom = newZoom

                                        /*
                                         * Keep the same image point under the fingers
                                         */
                                        var newContentX = imagePointX * newZoom - cx
                                        var newContentY = imagePointY * newZoom - cy
                                        var maxX = Math.max(0, imageFlickable.contentWidth - imageFlickable.width)
                                        var maxY = Math.max(0, imageFlickable.contentHeight - imageFlickable.height)
                                        imageFlickable.contentX = Math.max(0, Math.min(newContentX, maxX))
                                        imageFlickable.contentY = Math.max(0, Math.min(newContentY, maxY))

                                        return
                                    }

                                    /*
                                     * ONE FINGER
                                     */
                                    if (touch1.pressed) {
                                        var dx = touch1.x - lastX
                                        var dy = touch1.y - lastY
                                        /*
                                         * When zoomed, one finger moves around the image.
                                         */
                                        if (imageFlickable.zoom > 1.0) {
                                            var maxPanX = Math.max(0, imageFlickable.contentWidth - imageFlickable.width)
                                            var maxPanY = Math.max(0, imageFlickable.contentHeight - imageFlickable.height)

                                            imageFlickable.contentX = Math.max(0, Math.min(imageFlickable.contentX - dx, maxPanX))
                                            imageFlickable.contentY = Math.max(0, Math.min(imageFlickable.contentY - dy, maxPanY))
                                        }
                                    }
                                    if (Math.abs(touch1.x - pressX) > units.gu(1) || Math.abs(touch1.y  - pressY) > units.gu(1)) {
                                        moved = true
                                    }
                                    lastX = touch1.x
                                    lastY = touch1.y
                                }

                                onTouchUpdated: {
                                    /*
                                     * Let's wait until no finger is touching the screen
                                     */
                                    if (touch1.pressed || touch2.pressed) {
                                        return
                                    }
                                
                                    /*
                                     * If we arrive from a pinch, only clear the state.
                                     */
                                    if (pinching) {
                                        pinching = false
                                        if (imageFlickable.zoom <= imageFlickable.minZoom) {
                                            imageFlickable.zoom = imageFlickable.minZoom
                                            imageFlickable.contentX = 0
                                            imageFlickable.contentY = 0
                                        }
                                        moved = false
                                        return
                                    }
                                    var deltaX = lastX - pressX
                                    var deltaY = lastY - pressY

                                    /*
                                     * Horizontal swipe with normal zoom.
                                     */
                                    if (imageFlickable.zoom <= 1.0 && Math.abs(deltaX) > units.gu(4) && Math.abs(deltaX) > Math.abs(deltaY)) {
                                        var newIndex = imageViewer.currentIndex
                                        if (deltaX < 0) {
                                            newIndex ++
                                        } else {
                                            newIndex --
                                        }
                                        newIndex = Math.max(0, Math.min(newIndex, imageViewer.count - 1))
                                        if (newIndex !== imageViewer.currentIndex) {
                                            imageViewer.currentIndex = newIndex
                                            imageViewer.positionViewAtIndex(newIndex, ListView.Beginning)
                                        }
                                        moved = false
                                        return
                                    }
                                    /*
                                    * If there was movement, it wasn't a tap.
                                    */
                                    if (moved) {
                                        moved = false
                                        return
                                    }
                                    /*
                                     * Detect double tap.
                                     */
                                    var now = Date.now()
                                    var elapsed = now -lastTapTime
                                    console.log("Tap visor: ", elapsed)
                                    if (lastTapTime > 0 && elapsed < doubleTapInterval) {
                                        imagePage.fullScreen = !imagePage.fullScreen
                                        lastTapTime = 0
                                    } else {
                                        lastTapTime = now
                                    }
                                }

                                onCanceled: {
                                    pinching = false
                                    moved = false
                                }
                            }

                            onZoomChanged: {
                                if (zoom <= minZoom) {
                                    zoom = minZoom
                                    contentX = 0
                                    contentY = 0
                                    imageViewer.interactive = true
                                } else {
                                    imageViewer.interactive = false
                                }
                            }
                        }
                    }           

                    Component.onCompleted: {
                        positionViewAtIndex(
                            initialIndex,
                            ListView.Beginning
                        )
                        currentIndex = initialIndex
                    }

                    onCurrentIndexChanged: {
                        console.log(
                            "Imagen actual:",
                            currentIndex
                        )
                    }
                }
            }
        }

        Component {
            id: slideshowPageComponent

            Page {
                id: slideshowPage
                
                header: PageHeader {
                    id: slideshowHeader
                    exposed: false
                }

                ScreenSaver {
                    id: screenSaver
                    screenSaverEnabled: false
                }

                /*
                 * Time between pictures, in miliseconds
                 */
                property int slideInterval: 3000

                Component.onCompleted: {
                    window.visibility = Window.FullScreen
                    slideshowViewer.currentIndex = 0
                    slideshowViewer.positionViewAtIndex(0, ListView.Beginning)
                    slideshowTimer.start()
                }

                Component.onDestruction: {
                    screenSaver.screenSaverEnabled = true
                    window.visibility = Window.AutomaticVisibility
                }

                ListView {
                    id: slideshowViewer

                    anchors.fill: parent

                    orientation: ListView.Horizontal
                    interactive: false

                    model: mediaModel
                    currentIndex: 0

                    snapMode: ListView.SnapOneItem
                    highlightRangeMode: ListView.StrictlyEnforceRange

                    preferredHighlightBegin: 0
                    preferredHighlightEnd: 0

                    boundsBehavior: Flickable.StopAtBounds

                    clip: true

                    delegate: Rectangle {
                        width: slideshowViewer.width
                        height: slideshowViewer.height
                        color: "black"

                        Image {
                            anchors.fill: parent
                            source: "file://" + path
                            fillMode: Image.PreserveAspectFit
                            asynchronous: true
                            cache: true
                            smooth: true
                        }

                        MouseArea {
                            anchors.fill: parent
                            /*
                             * Let user to leave slide show by tapping the screen
                             */
                            onClicked: {
                                slideshowTimer.stop()
                                pageStack.pop()
                            }
                        }
                    }
                }

                Timer {
                    id: slideshowTimer
                    interval: slideshowPage.slideInterval
                    repeat: true
                    onTriggered: {
                        /*
                         * Let's advance to the next while there are pictures left
                         */
                        if(slideshowViewer.currentIndex < slideshowViewer.count -1) {
                            var nextIndex = slideshowViewer.currentIndex + 1
                            slideshowViewer.currentIndex = nextIndex
                            slideshowViewer.positionViewAtIndex(nextIndex, ListView.Beginning)
                        } else {
                            /*
                             * Last pic --> stop slide presentation
                            */
                            slideshowTimer.stop()
                            pageStack.pop()
                        }
                    }
                }
            }
        }
    }
}